{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_WS_ORIGIN": "wss://advertiser-arabic-tree-beans.trycloudflare.com"
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://spotstratcloud.vercel.app/v1/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
