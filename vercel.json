{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "env": {
    "VITE_WS_ORIGIN": "wss://creatures-ringtone-toll-discussions.trycloudflare.com",
    "VITE_GOOGLE_CLIENT_ID": "98371392821-ca4oqqttpoje9uc952it3arfd47f2a2s.apps.googleusercontent.com"
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://cloud-nine-gilt.vercel.app/v1/:path*"
    },
    {
      "source": "/relay/:path*",
      "destination": "https://cloud-nine-gilt.vercel.app/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
